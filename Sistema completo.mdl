{UTF-8}
Area=100
	~	miles2
	~		|

Building Rate=Yearly Profits*(Fraction Invested/Ship Cost)
	~	ship/Year
	~		|

Carrying Capacity=1200
	~	fish
	~		|

Catch per Ship = WITH LOOKUP (Density,
		([(0,0)-(12,25.5)],(0,0), (1,5), (2,10.4), (3,15.9), (4,20.2), (5,22.1), (6,23.2), \
		(7,23.8), (8,24.2), (9,24.6), (10,25), (11,25.3), (12,25.5)))
	~	
	~		|

Costs=SHIP*250
	~	$/Year
	~		|

Death Fraction = WITH LOOKUP (Fish/Carrying Capacity,
		([(0,5.22)-(1,6)],(0,5.22), (0.1,5.22), (0.2,5.23), (0.3,5.24), (0.4,5.26), (0.5,5.29\
		), (0.6,5.34), (0.7,5.45), (0.8,5.66), (0.9,5.94), (1,6)))
	~	
	~		|

Density=Fish/Area
	~	fish/miles2
	~		|

Fish= INTEG (Fish Hatch Rate-Fish Death Rate-Total Catch per Year,
		1000)
	~	fish
	~		|

Fish Death Rate=Death Fraction*Fish
	~	fish/Year
	~		|

Fish Hatch Rate=Fish*Hatch Fraction
	~	fish/Year
	~		|

Fish Price=20
	~	$/fish
	~		|

Fraction Invested=0.2
	~	
	~		|

Hatch Fraction=6
	~	1/Year
	~		|

Revenues=Total Catch per Year*Fish Price
	~	$/Year
	~		|

SHIP= INTEG (Building Rate,
		10
		)
	~	
	~		|

Ship Cost=300
	~	$/ship
	~		|

Total Catch per Year=SHIP*Catch per Ship
	~	fish/Year
	~		|

Yearly Profits=Revenues-Costs
	~	$/Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 12
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.1
	~	Year [0,?]
	~	The time step for the simulation.
	|

